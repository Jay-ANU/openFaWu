# Copy to .env.codex or run `make -f openfawu.mk codex-init`.
# The bridge only binds to loopback and never exposes a raw shell HTTP endpoint.
OPENFAWU_CODEX_BRIDGE_HOST=127.0.0.1
OPENFAWU_CODEX_BRIDGE_PORT=8765
OPENFAWU_CODEX_BRIDGE_TOKEN=

# One or more permitted workspace roots separated by the OS path separator
# (`:` on macOS/Linux, `;` on Windows). Leave empty to use
# ~/.openfawu/workspaces.
OPENFAWU_CODEX_ALLOWED_ROOTS=

# Browser origins that may call the bridge.
OPENFAWU_CODEX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Codex CLI executable. A full path is supported.
OPENFAWU_CODEX_BIN=codex

# Dangerous opt-out. Leave false: the web UI intentionally only exposes
# on-request/untrusted approval policies by default.
OPENFAWU_CODEX_ALLOW_NO_APPROVAL=false
