# Copy to .env.solo. solo-init.sh will generate missing local secrets.
OPENFAWU_USERNAME=admin
OPENFAWU_EMAIL=admin@openfawu.local
OPENFAWU_PASSWORD=
OPENFAWU_DJANGO_SECRET_KEY=

# OpenContracts model configuration. The app and Local Codex bridge can run
# without this key; OpenContracts hosted-agent and embedding tasks cannot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=384
OPENAI_API_BASE_URL=

OPENFAWU_FRONTEND_PORT=3000
OPENFAWU_BACKEND_PORT=8000
